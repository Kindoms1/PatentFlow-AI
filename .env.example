# 只保留变量名。开发密钥写入 .env.local，正式部署单独使用 .env.production.local，不要提交。
# AGNES_* 是兼容保留的变量名，可用于其他 OpenAI-compatible 服务。
# DeepSeek 示例：AGNES_BASE_URL=https://api.deepseek.com；AGNES_MODEL 使用账户实际返回的可用模型。
AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_MODEL=agnes-2.5-flash
AGNES_WEBSITE=https://www.agnes-ai.com/
ANYSEARCH_API_KEY=
ANYSEARCH_BASE_URL=https://api.anysearch.com
ANYSEARCH_WEBSITE=https://www.anysearch.com/
